            "residence",
            "dialCode",
            "phone",
            "email",
            "channel",
            "instagram"
          ],
          "additionalProperties": false
        },
        "vibe": {
          "type": "object",
          "properties": {
            "moment": {
              "type": "string",
              "enum": [
                "Daytime by the pool",
                "Horadiso, the sunset hour",
                "After dark"
              ]
            },
            "music": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Deep and soulful house",
                  "Melodic and progressive",
                  "Tech house and techno",
                  "Disco and nu disco",
                  "Surprise me"
                ]
              },
              "minItems": 1,
              "maxItems": 2,
              "description": "Unique music selections; server must enforce uniqueness.",
              "uniqueItems": true
            },
            "move": {
              "type": "string",
              "enum": [
                "Front of the dance floor",
                "Drink in hand, gently swaying",
                "Sunbed and sea views",
                "A little of everything"
              ]
            },
            "group": {
              "type": "string",
              "enum": [
                "My partner",
                "A mixed group of friends",
                "A girls’ day out",
                "A boys’ day out",
                "A celebration with my crew"
              ]
            },
            "occasion": {
              "anyOf": [
                {
                  "type": "string",
                  "const": ""
                },
                {
                  "type": "string",
                  "enum": [
                    "Birthday",
                    "Anniversary",
                    "Engagement",
                    "Business",
                    "Just because"
                  ]
                }
              ]
            },
            "occasionDate": {
              "type": "string",
              "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
              "description": "Empty or a real calendar date; server must reject impossible calendar dates."
            }
          },
          "required": [
            "moment",
            "music",
            "move",
            "group",
            "occasion",
            "occasionDate"
          ],
          "additionalProperties": false
        },
        "consent": {
          "type": "object",
          "properties": {
            "adult": {
              "type": "boolean",
              "const": true
            },
            "policy": {
              "type": "boolean",
              "const": true
            },
            "privacy": {
              "type": "boolean",
              "const": true
            },
            "marketing": {
              "type": "boolean"
            },
            "policyVersion": {
              "type": "string",
              "const": "2026-10-29-draft"
            },
            "privacyVersion": {
              "type": "string",
              "const": "2026-10-29-draft"
            }
          },
          "required": [
            "adult",
            "policy",
            "privacy",
            "marketing",
            "policyVersion",
            "privacyVersion"
          ],
          "additionalProperties": false
        },
        "attribution": {
          "type": "object",
          "properties": {
            "utm_source": {
              "type": "string",
              "maxLength": 255
            },
            "utm_medium": {
              "$ref": "#/definitions/SOARRegistration/properties/attribution/properties/utm_source"
            },
            "utm_campaign": {
              "$ref": "#/definitions/SOARRegistration/properties/attribution/properties/utm_source"
            },
            "referrer": {
              "type": "string",
              "maxLength": 2048
            },
            "landing_path": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "required": [
            "utm_source",
            "utm_medium",
            "utm_campaign",
            "referrer",
            "landing_path"
          ],
          "additionalProperties": false
        }
