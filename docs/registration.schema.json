              "type": "string",
              "pattern": "^[\\d\\s()+-]{6,25}$"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 255
            },
            "channel": {
              "type": "string",
              "enum": [
                "WhatsApp",
                "LINE",
                "WeChat",
                "Instagram DM",
                "Email"
              ]
            },
            "instagram": {
              "type": "string",
              "pattern": "^@?[A-Za-z0-9._]{0,30}$"
            }
